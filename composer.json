{
    "name": "nvl/billing",
    "description": "Tenant-owned Stripe subscription billing for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "billing",
        "stripe",
        "subscriptions"
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.0",
        "nvl/core": "^5.0",
        "nvl/tenancy": "^5.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "stripe/stripe-php": "^21.0"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Billing\\": "src/",
            "Nvl\\Billing\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Billing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Billing\\Providers\\BillingServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/vendor",
            "/composer.lock",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/nvl-laravel-suite/billing",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/billing",
        "docs": "https://github.com/nvl-laravel-suite/billing#readme",
        "issues": "https://github.com/nvl-laravel-suite/billing/issues",
        "security": "https://github.com/nvl-laravel-suite/billing/security/policy"
    }
}
